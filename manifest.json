{
  "manifest_version": 3,
  "name": "Gleaner",
  "version": "0.5.0",
  "description": "Capture research sources into your Obsidian vault.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel", "contextMenus", "scripting", "activeTab"],
  "optional_host_permissions": [
    "https://127.0.0.1/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Open Gleaner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "capture-snippet": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture selected text"
    },
    "capture-page": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Capture this page"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "sidebar_action": {
    "default_title": "Gleaner",
    "default_panel": "src/sidepanel/sidepanel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gleaner@nasapsin.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
